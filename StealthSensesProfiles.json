// Stealth Senses — sense profiles: how well an NPC reads the player's footprints.
//
// Fields (1 = an ordinary person):
//   tracking       footprint visibility and the distance it notices one from, times this; 0 = never reads them
//   tracking_mult  multiplies the tracking the rules below it gave (use it for factions: a Bosmer hunter keeps the Bosmer bonus)
//   night          how much darkness hurts reading (1 = fully, 0 = sees in the dark)
//   blood          bloody footprints: visibility and notice distance times this, on top of tracking
//   blood_mult     multiplies the blood the rules below it gave
//   smell          scent range multiplier (0 = none), independent of vision; calibrated separately
//   smell_blood    additional scent range for blood; combined range multiplier capped at 4
//   smell_mult     multiplies scent range from earlier layers
//   smell_hunt     can investigate ordinary scent while calm; does not change vanilla hostility
//
// A rule matches on exactly one of: keyword, race, class, faction, npc — "Plugin.esm|FormID" (hex,
// without the load order byte). Rules apply in that order (a faction over a race over a keyword),
// then in file order. "name" shows in the log; "why" is for people and ignored.
// Other mods can add StealthSensesProfiles_<Name>.json next to this file: read after it, in name order.
{
    "default": { "tracking": 0.0, "smell": 0.0, "smell_blood": 1.0, "smell_hunt": false },
    "rules": [
        { "keyword": "Skyrim.esm|013794", "name": "person", "tracking": 1.0, "smell": 0.08,
          "why": "ActorTypeNPC: reading footprints takes a mind. Animals, automatons, draugr and other creatures do not (before 0.11: humanoids_only)" },

        { "keyword": "Skyrim.esm|013796", "name": "undead", "smell": 0.0, "smell_hunt": false },
        { "keyword": "Skyrim.esm|013797", "name": "daedra", "smell": 0.0, "smell_hunt": false },
        { "keyword": "Skyrim.esm|01397A", "name": "automaton", "smell": 0.0, "smell_hunt": false },

        { "race": "Skyrim.esm|0131F4", "name": "falmer", "tracking": 0.0, "smell": 1.6,
          "why": "Falmer are blind: racial ability AbFalmer = AbBlind 80; 'the snow elves, for time eternal, would be blind' (The Falmer: A Study)" },
        { "race": "Dawnguard.esm|01AACC", "name": "falmer", "tracking": 0.0, "smell": 1.6,
          "why": "FalmerFrozenVampRace, as above" },

        { "race": "Skyrim.esm|013749", "name": "bosmer", "tracking": 1.4,
          "why": "Born hunters and scouts: 'make good scouts... no finer archers in all of Tamriel' (race description), Archery +10, Sneak +5" },
        { "race": "Skyrim.esm|088884", "name": "bosmer", "tracking": 1.4, "why": "WoodElfRaceVampire, as above" },

        { "race": "Skyrim.esm|013745", "name": "khajiit", "tracking": 1.1, "night": 0.0, "smell": 0.9,
          "why": "'All Khajiit can see in the dark' (race description), Night Eye; a follower: 'I'll smell them coming'" },
        { "race": "Skyrim.esm|088845", "name": "khajiit", "tracking": 1.1, "night": 0.0, "why": "KhajiitRaceVampire, as above" },
        { "race": "Skyrim.esm|013740", "name": "argonian", "smell": 0.6,
          "why": "Gulum-Ei recognises the Guild by scent. Relative sensitivity is mod balance, not a measured lore ranking" },

        { "keyword": "Skyrim.esm|0A82BB", "name": "vampire", "night": 0.0, "blood": 2.0, "smell": 1.6, "smell_blood": 4.0,
          "why": "Keyword Vampire on every vampire race. 'I knew I smelled mortal blood!' (Dawnguard vampires, alert to combat), 'I can smell your blood!'; VampireHuntersSight (night eye)" },

